!(bind! &q (new-space queue))
!(assertEqualToResult (space-len &q) (0))
!(assertEqualToResult (space-push &q alpha) (()))
!(assertEqualToResult (space-push &q beta) (()))
!(assertEqualToResult (space-peek &q) (alpha))
!(assertEqualToResult (space-get &q 1) (beta))
!(assertEqualToResult (space-pop &q) (alpha))
!(assertEqualToResult (space-peek &q) (beta))

!(bind! &stk (new-space stack))
!(assertEqualToResult (space-push &stk alpha) (()))
!(assertEqualToResult (space-push &stk beta) (()))
!(assertEqualToResult (space-peek &stk) (beta))
!(assertEqualToResult (space-pop &stk) (beta))

!(bind! &h (new-space hash))
!(add-atom &h (seen alpha))
!(add-atom &h (seen beta))
!(assertEqualToResult (space-len &h) (2))
!(assertEqual (size &h) (space-len &h))
