!(import! &self ../../lib/lib_datastructures.metta)

(= (bfs_loop_limited (empty-queue) $N0 $limit) $N0)
(= (bfs_loop_limited $Q $N0 $limit)
   (if (>= $N0 $limit)
       $N0
       (let* (($Q1 (once (dequeue $S $Q)))
              ($Ln (collapse (let* (($Snew (move $S $_))
                                    ($2 (add-unique-or-fail &dup $Snew)))
                               $Snew)))
              ($Q2 (foldl enqueue $Ln $Q1))
              ($N1 (+ $N0 1)))
         (bfs_loop_limited $Q2 $N1 $limit))))

(= (bfs_all_limited $Start $limit)
   (let* (($seed (add-unique-or-fail &dup $Start))
          ($Q1 (enqueue $Start (empty-queue))))
     (bfs_loop_limited $Q1 0 $limit)))

