(= (fold-nested $f $init ()) $init)
(= (fold-nested $f $init (cons $x $xs))
   (if (is-expr $x)
       (fold-nested $f (fold-nested $f $init $x) $xs)
       (fold-nested $f ($f $init $x) $xs)))
(= (range $n)
   (if (== $n 0) ()
       (cons $n (range (- $n 1)))))
(= (deep-nest $n)
   (if (== $n 0) ()
       (cons (range 50) (deep-nest (- $n 1)))))

!(assertEqualToEval (fold-nested + 0 (1 (2 3))) 6)
!(assertEqualToEval (fold-nested + 0 (deep-nest 3)) 3825)
!(assertEqual (fold-nested + 0 foo) (fold-nested + 0 foo))
