!(import! &self (library lib_det))
(: one (-[det]-> Number Number))
(= (one $x) $x)
(: many (-[nondet]-> Number Number))
(= (many $x) (superpose ($x (+ $x 1))))
(: pick-second (-[$e]-> (-[$e]-> Number Number) (-[$e]-> Number Number) Number Number))
(= (pick-second $a $b $x) ($b $x))
(: f (-[det]-> Number Number))
(= (f $x) (pick-second one many $x))
!(det-verdict f)
!(collapse (f 1))
