!(add-atom &wuspace (wu))
!(add-atom &wuspace (wu 42))

!(assertEqualToEval (collapse (match &wuspace ($x) ($x))) ((wu)))
!(assertEqualToEval (collapse (match &wuspace ($x) $x)) (wu))
!(assertEqualToEval (collapse (once (match &wuspace (wu) True))) (true))
!(assertEqualToEval (collapse (once (match &wuspace (missing) True))) ())
!(assertEqualToEval (collapse (once (match &wuspace ($x) True))) (true))
!(assertEqualToEval (== () (collapse (once (match &wuspace (missing) True)))) true)
!(assertEqualToEval (== () (collapse (once (match &wuspace (wu) True)))) false)
