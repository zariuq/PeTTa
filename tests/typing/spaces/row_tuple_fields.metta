(: Ctx (Newtype Atom))
(: Score Type)
(: score (-> Number Score))
(: &kb (SpaceOf (Ctx Score)))
!(bind! &kb (new-space))
!(let $c (brand Ctx a) (add-atom &kb ($c (score 1))))
!(add-atom &kb ((brand Ctx a) (score 2)))
(: value (-> Score Number))
(= (value (score $n)) $n)
!(collapse (match &kb ($c $s) (value $s)))
!(add-atom &kb (b 7))
