!(test (size-atom abc) ())
!(test (min-atom abc) ())
!(test (max-atom abc) ())
!(test (min-atom (abc)) abc)
!(test (max-atom (abc)) abc)
!(test (min-atom ("hello")) "hello")
!(test (max-atom ("hello")) "hello")
!(test (+ (size-atom (1 2 3)) 1) 4)
!(test (+ (size-atom ()) 1) 1)
!(test (+ (min-atom (1 2 3)) 1) 2)
!(test (+ (max-atom (1 2 3)) 1) 4)
(: typed-size (-> (List Number) Number))
(= (typed-size $xs) (size-atom $xs))
(: typed-min (-> (List Number) Number))
(= (typed-min $xs) (min-atom $xs))
(: typed-max (-> (List Number) Number))
(= (typed-max $xs) (max-atom $xs))
!(test (typed-size (1 2 3)) 3)
!(test (typed-min (1 2 3)) 1)
!(test (typed-max (1 2 3)) 3)
