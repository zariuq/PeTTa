(= (mark $label $value) (progn (println! $label) $value))
!(test (and-then (mark "A-skip" False) (mark "BAD-A-skip" True)) False)
!(test (or-else (mark "O-skip" True) (mark "BAD-O-skip" False)) True)
!(test (and-then (mark "A-left" True) (mark "A-right" False)) False)
!(test (or-else (mark "O-left" False) (mark "O-right" True)) True)
!(test (collapse (and-then True (superpose (True False True)))) (True False True))
!(test (collapse (or-else False (superpose (True False True)))) (True False True))
!(test (collapse (and-then (superpose (True False)) (mark "A-nondet-right" True))) (True False))
!(test (collapse (or-else (superpose (True False)) (mark "O-nondet-right" False))) (True False))
!(test (collapse (and-then True (empty))) ())
!(test (collapse (or-else False (empty))) ())
