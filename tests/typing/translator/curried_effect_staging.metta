!(bind! &runs (new-state 0))
(: base (-> Number Number Number))
(= (base $x $y) (+ $x $y))
(: curried (-> Number (-> Number Number)))
(= (curried $x)
   (progn (change-state! &runs (+ 1 (get-state &runs)))
          (base $x)))
!(let $f (reduce (curried 1))
   (progn (println! (get-state &runs))
          ($f 2)
          ($f 3)
          (get-state &runs)))
