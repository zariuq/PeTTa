(= (unknown-id $x) $x)
(= (bind-num $x) (let $x 1 ok))
(= (bind-str $x) (let $x "s" ok))
(= (bind-bool $x) (let $x True ok))
(: f (-> Number Number))
(: f (-> String String))
(= (f $x) $fresh)
!(let $r (f $x)
   (progn (bind-num $x)
      (let $copied (copy_term $r) (progn (bind-str $copied) $copied))))
