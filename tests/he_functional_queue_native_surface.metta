!(import! &self ../lib/lib_datastructures.metta)

!(assertEqual (empty-queue) (queue () () 0))
!(assertEqual (enqueue 1 (empty-queue)) (queue (cons 1 ()) () 1))
!(assertEqualToResult (let $q (enqueue 1 (empty-queue)) (dequeue $x $q))
                      ((queue () () 0)))
!(assertEqualToResult (let $q (enqueue 1 (empty-queue)) (once (dequeue $x $q)))
                      ((queue () () 0)))
!(assertEqualToResult (let $q (enqueue 1 (empty-queue)) (select (dequeue $x $q)))
                      ((queue () () 0)))
!(assertEqualToResult (once (dequeue $x (empty-queue)))
                      ())
!(assertEqualToResult (let $q (enqueue (___ 1 2 3 4 5 6 7 8) (empty-queue))
                        (once (dequeue $x $q)))
                      ((queue () () 0)))

!(assertEqual (enqueue 1 2) (enqueue 1 2))
!(assertEqual (dequeue $x 2) (dequeue $x 2))
!(assertEqual (once (dequeue $x 2)) (dequeue $x 2))

!(bind! &dup (new-space))
!(assertEqualToResult (let $u1 (add-unique-or-fail &dup (a b))
                        (add-unique-or-fail &dup (a b)))
                      ())
